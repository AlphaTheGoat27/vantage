# Free key from https://aistudio.google.com/apikey (Gemini categorizes, replans and explains)
GEMINI_API_KEY=
# Optional: override the Gemini model. Default order: gemini-3.5-flash, gemini-flash-lite-latest, gemini-flash-latest
# (gemini-2.5-flash is closed to new API keys)
GEMINI_MODEL=
# Optional but recommended: free key from https://aisstream.io (live ship positions and AIS anomalies).
# Server-side only: never prefix with NEXT_PUBLIC_, never commit it. Without it the app runs without live ships.
AISSTREAM_API_KEY=
# Optional: Cesium ion token (not needed; the globe uses keyless Esri/OSM imagery)
NEXT_PUBLIC_CESIUM_ION_TOKEN=
